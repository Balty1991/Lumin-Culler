<?xml version="1.0" encoding="utf-8"?>
<!-- Rama vie: poza nouă intră lin, apropiindu-se ușor (ca o cameră care respiră). -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:anim/decelerate_interpolator">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="1600" />
    <scale android:fromXScale="1.08" android:toXScale="1" android:fromYScale="1.08" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="2400" />
</set>
