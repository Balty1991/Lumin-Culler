<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Aceeași regulă ca backup_rules.xml: pleacă doar cherrypic-backup.json. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="cherrypic-backup.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="cherrypic-backup.json" />
    </device-transfer>
</data-extraction-rules>
