<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Fără windowOptOutEdgeToEdgeEnforcement: e ignorat pe Android 16 (targetSdk 36), iar
             MainActivity face edge-to-edge peste tot (EdgeToEdge.enable) și trimite înălțimea
             barelor în variabilele CSS safe-top / safe-bottom. Play semnala opțiunea ca problemă. -->
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Splash-ul sistemului (Android 12+): negru black rose, cu cireașa — la fel ca
             logo-ul care urmează, ca pornirea să nu clipească între trei ecrane diferite. -->
        <item name="windowSplashScreenBackground">#050305</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <!-- OBLIGATORIU cu SplashScreen.installSplashScreen(): tema de după splash. Fără ea,
             activitatea rămânea pe Theme.SplashScreen (nu e AppCompat), iar
             setKeepOnScreenCondition caută android.R.id.content înainte ca BridgeActivity
             să schimbe tema: AppCompat crea decorul și oprea aplicația la pornire
             („You need to use a Theme.AppCompat theme”, versiunea 46). -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>