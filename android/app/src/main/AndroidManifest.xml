<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup="false": Auto Backup pe Google Drive ar copia si stocarea privata a
         aplicatiei (IndexedDB/Dexie), unde stau embeddingurile faciale ale "persoanelor
         cunoscute" — contrazice direct politica de confidentialitate ("nu paraseste
         niciodata dispozitivul"). Bug real gasit de auditul QA. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Doar pentru "cate poze ai in galerie" (Acasa, plan modernizare) — o interogare
         MediaStore de NUMARAT, nu de citit bytes. Selectorul de import (pickPhotos,
         ACTION_OPEN_DOCUMENT) NU are nevoie de asta, ramane neschimbat. Ambele declarate,
         standard Android: READ_MEDIA_IMAGES pe API 33+ (Android 13), READ_EXTERNAL_STORAGE
         cu maxSdkVersion pe API-uri mai vechi (ignorata automat de sistem pe 33+). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 14+: se acorda cand utilizatorul alege "Permite cu acces limitat".
         Declarata ca s-o putem INTERBOGA si sa deosebim accesul partial de un
         refuz total — vezi photosAccess() in MediaLibraryPlugin.kt. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Coordonatele GPS din EXIF-ul pozelor. Incepand cu Android 10, sistemul le
         STERGE din fisierul servit oricarei aplicatii, oricat acces la galerie ar
         avea; fara permisiunea asta (plus MediaStore.setRequireOriginal la citire)
         nicio poza importata n-are locatie, iar "Calatorii" de pe Acasa ramane
         gol pentru totdeauna — bug real raportat de utilizator. Coordonatele se
         folosesc DOAR local, ca sa grupeze pozele in calatorii (state/trips.ts);
         nu se trimit nicaieri, ca tot restul analizei. Vezi photoLocations() in
         MediaLibraryPlugin.kt. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
</manifest>
